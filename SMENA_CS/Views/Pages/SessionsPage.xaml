<UserControl x:Class="SMENA.Views.SessionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <Style x:Key="Hdr" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="SESSIONS — Shift-click a range, right-click for actions" Style="{StaticResource Hdr}" Margin="0,0,0,6"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding TodayRows}" SelectionMode="Extended"
                         SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeRange}" FontSize="12" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Duration}" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding App}" FontSize="12" Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding Task}" FontSize="11" Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}"
                Visibility="{Binding SessionDetailsVisible, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="SESSION DETAILS" Style="{StaticResource Hdr}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Started" Foreground="{DynamicResource FgDim}" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedSession.TimeRange}" FontSize="12" Foreground="{DynamicResource Fg}" Margin="0,1,0,6"/>
                        <TextBlock Grid.Row="1" Text="Duration" Foreground="{DynamicResource FgDim}" FontSize="11"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSession.Duration}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,1,0,6"/>
                        <TextBlock Grid.Row="2" Text="Application" Foreground="{DynamicResource FgDim}" FontSize="11"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSession.App}" FontSize="12" Foreground="{DynamicResource Fg}" Margin="0,1,0,6"/>
                        <TextBlock Grid.Row="3" Text="Task" Foreground="{DynamicResource FgDim}" FontSize="11"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedSession.Task}" FontSize="12" Foreground="{DynamicResource Fg}" Margin="0,1,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding SelectedSession.Title}" FontSize="11" Foreground="{DynamicResource FgDim}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Text="NOTE" Style="{StaticResource Hdr}" Margin="0,14,0,4"/>
                    <TextBox Text="{Binding SessionNote, UpdateSourceTrigger=PropertyChanged}" MinHeight="70"
                             TextWrapping="Wrap" AcceptsReturn="True" FontSize="11"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Click="SaveNote_Click" Content="SAVE NOTE" Padding="8,4" FontSize="10"/>
                        <Button Click="Edit_Click" Content="EDIT" Padding="8,4" FontSize="10" Margin="6,0,0,0"/>
                        <Button Click="Assign_Click" Content="ASSIGN" Padding="8,4" FontSize="10" Margin="6,0,0,0"/>
                        <Button Click="Delete_Click" Content="DELETE" Padding="8,4" FontSize="10" Margin="6,0,0,0" Foreground="{DynamicResource Red}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
