<UserControl x:Class="SMENA.Views.JournalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Hdr" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="{DynamicResource PanelHi}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,10">
            <TextBlock Text="JOURNAL" Style="{StaticResource Hdr}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Journal.Summary}" FontSize="11" Foreground="{DynamicResource FgDim}"
                       Margin="14,1,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="8" Padding="14,10">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Journal.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5" Background="Transparent">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Delete (time goes to Unsorted)" Click="JournalDelete_Click"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Dot}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Fg}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="10" Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding ProjectName}"/><Run Text="  ·  closed "/><Run Text="{Binding ClosedText}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontSize="11" Foreground="{DynamicResource Fg}"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Grid.Column="3" Click="JournalReopen_Click" Content="REOPEN" FontSize="9" Padding="8,3"
                                            VerticalAlignment="Center" ToolTip="Return the task to the active set"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="No closed tasks yet. Close a finished task from the dashboard: hover a task row and press ✓ (or right-click → Close task)."
                           FontSize="11" Foreground="{DynamicResource FgDim}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="420">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Journal.Rows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
