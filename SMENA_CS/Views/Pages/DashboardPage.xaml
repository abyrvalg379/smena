<UserControl x:Class="SMENA.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SMENA.Controls">
    <UserControl.Resources>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <Style x:Key="Hdr" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="IconChip" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="{DynamicResource PanelHi}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS-style toggle -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="11"/>
                            <Border x:Name="Track" Grid.Column="1" Width="36" Height="19" CornerRadius="10"
                                    Background="{DynamicResource Border}" VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Width="13" Height="13" Fill="{DynamicResource FgDim}"
                                         HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Fg}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHi}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="{Binding ViewportHeight, ElementName=RootScroll}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="235"/>
        </Grid.ColumnDefinitions>

        <!-- ===== WORKING card ===== -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#101720" Offset="0"/>
                    <GradientStop Color="#0F2318" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <Border Background="#1D3324" CornerRadius="5" Padding="9,4" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Green}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="WORKING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Green}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding HeroTime}" FontFamily="Consolas" FontSize="52" FontWeight="SemiBold"
                           Foreground="{DynamicResource Fg}" Margin="0,10,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{DynamicResource Green}" Opacity="0.9"/>
                    <TextBlock Text="{Binding WorkingTaskName}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding WorkingProjectName}" FontSize="11" Foreground="{DynamicResource FgDim}" Margin="18,2,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Border Background="{DynamicResource PanelHi}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconChip}" Text="&#xE7F4;" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding CurrentApp}" FontSize="11" Foreground="{DynamicResource Fg}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource PanelHi}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="4" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconChip}" Text="&#xE8A5;" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding CurrentFile}" FontSize="11" Foreground="{DynamicResource Fg}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Click="Pause_Click" MinWidth="120" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE769;" FontFamily="Segoe Fluent Icons" FontSize="11" Margin="0,0,8,0"/>
                            <TextBlock Text="Pause"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Stop_Click" MinWidth="90" Margin="10,0,0,0" Background="{DynamicResource RedSoft}" BorderBrush="{DynamicResource Red}" Foreground="{DynamicResource RedHi}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons" FontSize="11" Margin="0,0,8,0"/>
                            <TextBlock Text="Stop"/>
                        </StackPanel>
                    </Button>
                    <Button Click="AssignOpenBlock_Click" Content="…" MinWidth="44" Margin="10,0,0,0" ToolTip="Assign the block being tracked"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== TODAY card ===== -->
        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Today" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"/>
                    <TextBlock Text="{Binding StatTotal}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0" Fill="{DynamicResource Accent}"/>
                        <TextBlock FontSize="10" Foreground="{DynamicResource FgDim}"><Run Text="Working"/><Run Text="  "/><Run Text="{Binding LegendWorking, Mode=OneWay}" Foreground="{DynamicResource Fg}"/></TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0" Fill="{DynamicResource UnsortedBrush}"/>
                        <TextBlock FontSize="10" Foreground="{DynamicResource FgDim}"><Run Text="Unsorted"/><Run Text="  "/><Run Text="{Binding LegendUnsorted, Mode=OneWay}" Foreground="{DynamicResource Fg}"/></TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0" Fill="{DynamicResource IdleBrush}"/>
                        <TextBlock FontSize="10" Foreground="{DynamicResource FgDim}"><Run Text="Idle"/><Run Text="  "/><Run Text="{Binding LegendIdle, Mode=OneWay}" Foreground="{DynamicResource Fg}"/></TextBlock>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding TodayBars}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Bar}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Fg}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProject}" Value="True">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="FontSize" Value="12.5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsUnsorted}" Value="True">
                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Phase}" FontSize="9" Foreground="{DynamicResource FgDim}"
                                                       Margin="8,2,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Phase}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding MinutesText}" FontSize="11" Foreground="{DynamicResource Fg}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Border Grid.Column="3" Height="7" Background="{DynamicResource Track}" CornerRadius="4" VerticalAlignment="Center">
                                            <Rectangle HorizontalAlignment="Left" Fill="{Binding Bar}" RadiusX="4" RadiusY="4"
                                                       Width="{Binding Percent, FallbackValue=0}" MaxWidth="86"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsProject}" Value="True">
                                        <Setter Property="Margin" Value="0,8,0,2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsProject}" Value="False">
                                        <Setter Property="Margin" Value="14,2,0,2"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===== DONUT + QUICK STATS ===== -->
        <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <c:DonutControl Items="{Binding DonutItems}" CenterTitle="Total" CenterValue="{Binding StatTotal}"
                                    Height="130" Margin="0,4"/>
                    <TextBlock Text="QUICK STATS" Style="{StaticResource Hdr}" Margin="2,10,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Avg per day" FontSize="11" Foreground="{DynamicResource FgDim}"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatAvg}" FontSize="11" Foreground="{DynamicResource Fg}" TextAlignment="Right"/>
                        <TextBlock Grid.Row="1" Text="Longest session" FontSize="11" Foreground="{DynamicResource FgDim}" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StatLongest}" FontSize="11" Foreground="{DynamicResource Fg}" TextAlignment="Right" Margin="0,4,0,0"/>

                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== TIMELINE card ===== -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Timeline" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  " Foreground="{DynamicResource Border}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedDateLabel}" FontSize="11" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="GanttLabels" Grid.Column="0"/>
                    <Canvas x:Name="GanttCanvas" Grid.Column="1" Height="180"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== RECENT SESSIONS ===== -->
        <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource Card}" Margin="14,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="RECENT SESSIONS" Style="{StaticResource Hdr}" Margin="0,0,0,6"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding RecentRows}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Task}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Duration}" FontSize="11" Foreground="{DynamicResource Fg}"/>
                                </Grid>
                                <TextBlock Text="{Binding Title}" FontSize="10" Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding TimeRange}" FontSize="10" Foreground="{DynamicResource FgDim}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ===== WEEK ROW ===== -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Style="{StaticResource Card}" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,36,0">
                        <TextBlock Text="WEEK (7 DAYS)" Style="{StaticResource Hdr}"/>
                        <TextBlock Text="{Binding WeekTotal}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,36,0">
                        <TextBlock Text="AVG / DAY" Style="{StaticResource Hdr}"/>
                        <TextBlock Text="{Binding WeekAvg}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding WeekLabel}" FontSize="10" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="2" Click="Reports_Click" Content="REPORTS →" Padding="12,6" VerticalAlignment="Center"
                        ToolTip="Range reports with project tree, phases and export"/>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
