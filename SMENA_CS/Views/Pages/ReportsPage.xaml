<UserControl x:Class="SMENA.Views.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Hdr" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="{DynamicResource PanelHi}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header: title + total + exports -->
        <Grid Grid.Row="0" Margin="4,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="REPORTS" Style="{StaticResource Hdr}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Reports.RangeTotal}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource Fg}" Margin="18,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="total for the selected range" FontSize="10" Foreground="{DynamicResource FgDim}"
                           Margin="10,6,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Export →" FontSize="11" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button Click="ReportExport_Click" Tag="csv" Content="CSV" FontSize="9"/>
                <Button Click="ReportExport_Click" Tag="json" Content="JSON" FontSize="9" Margin="5,0,0,0"/>
                <Button Click="ReportExport_Click" Tag="md" Content="MD" FontSize="9" Margin="5,0,0,0"/>
                <Button Click="ReportExport_Click" Tag="html" Content="HTML" FontSize="9" Margin="5,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- range picker -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,0,0,10">
            <ListBox ItemsSource="{Binding Reports.RangeList}" SelectedItem="{Binding Reports.Range, Mode=TwoWay}"
                     BorderThickness="0" Background="Transparent">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{DynamicResource PanelHi}" BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,6,0">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <StackPanel Orientation="Horizontal" Visibility="{Binding Reports.IsCustom, Converter={StaticResource BoolToVis}}">
                <TextBox Text="{Binding Reports.CustomFrom, UpdateSourceTrigger=LostFocus}" Width="90" FontSize="11" Padding="6,4" ToolTip="From (dd.MM.yyyy)"/>
                <TextBlock Text="→" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="6,0"/>
                <TextBox Text="{Binding Reports.CustomTo, UpdateSourceTrigger=LostFocus}" Width="90" FontSize="11" Padding="6,4" ToolTip="To (dd.MM.yyyy)"/>
            </StackPanel>
        </StackPanel>

        <!-- project → task tree -->
        <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Reports.TreeRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Bar}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Fg}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsProject}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="FontSize" Value="13"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsUnsorted}" Value="True">
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Phase}" FontSize="9" Foreground="{DynamicResource FgDim}"
                                               Margin="8,2,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Phase}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding MinutesText}" FontSize="11"
                                           Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Grid.Column="3" Height="6" Background="{DynamicResource Track}" CornerRadius="3" VerticalAlignment="Center">
                                    <Rectangle HorizontalAlignment="Left" Fill="{Binding Bar}" RadiusX="3" RadiusY="3"
                                               Width="{Binding Percent, FallbackValue=0}" MaxWidth="120"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- phase rollup -->
        <Border Grid.Row="3" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14"
                Visibility="{Binding Reports.HasPhases, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="BY PHASE" Style="{StaticResource Hdr}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding Reports.PhaseRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Bar}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding MinutesText}" FontSize="11" Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
                                <Border Grid.Column="3" Height="6" Background="{DynamicResource Track}" CornerRadius="3" VerticalAlignment="Center">
                                    <Rectangle HorizontalAlignment="Left" Fill="{Binding Bar}" RadiusX="3" RadiusY="3"
                                               Width="{Binding Percent, FallbackValue=0}" MaxWidth="120"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- week grid (task × day matrix) -->
        <Expander Grid.Row="4" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
                  BorderThickness="1" Padding="14,10">
            <Expander.Header>
                <TextBlock Text="WEEK GRID — tasks × days" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource FgDim}"/>
            </Expander.Header>
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="TASK" Style="{StaticResource Hdr}"/>
                        <TextBlock Grid.Column="1" Text="{Binding WeekDayHeaders[0]}" Style="{StaticResource Hdr}" FontSize="10" TextAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="{Binding WeekDayHeaders[1]}" Style="{StaticResource Hdr}" FontSize="10" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="{Binding WeekDayHeaders[2]}" Style="{StaticResource Hdr}" FontSize="10" TextAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="{Binding WeekDayHeaders[3]}" Style="{StaticResource Hdr}" FontSize="10" TextAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="{Binding WeekDayHeaders[4]}" Style="{StaticResource Hdr}" FontSize="10" TextAlignment="Right"/>
                        <TextBlock Grid.Column="6" Text="{Binding WeekDayHeaders[5]}" Style="{StaticResource Hdr}" FontSize="10" TextAlignment="Right"/>
                        <TextBlock Grid.Column="7" Text="{Binding WeekDayHeaders[6]}" Style="{StaticResource Hdr}" FontSize="10" TextAlignment="Right"/>
                        <TextBlock Grid.Column="8" Text="TOTAL" Style="{StaticResource Hdr}" TextAlignment="Right"/>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding WeekGrid}" MaxHeight="360"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CellName" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Fg}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Cells[0]}" FontSize="11" Foreground="{DynamicResource Fg}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Cells[1]}" FontSize="11" Foreground="{DynamicResource Fg}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Cells[2]}" FontSize="11" Foreground="{DynamicResource Fg}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Cells[3]}" FontSize="11" Foreground="{DynamicResource Fg}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Cells[4]}" FontSize="11" Foreground="{DynamicResource Fg}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="6" Text="{Binding Cells[5]}" FontSize="11" Foreground="{DynamicResource Fg}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="7" Text="{Binding Cells[6]}" FontSize="11" Foreground="{DynamicResource Fg}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="8" Text="{Binding Total}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" TextAlignment="Right"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsGroupRow}" Value="True">
                                        <Setter TargetName="CellName" Property="FontWeight" Value="SemiBold"/>
                                        <Setter TargetName="CellName" Property="Foreground" Value="{DynamicResource Accent}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsGroupRow}" Value="False">
                                        <Setter TargetName="CellName" Property="Margin" Value="18,0,0,0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                                        <Setter TargetName="CellName" Property="FontWeight" Value="Bold"/>
                                        <Setter TargetName="CellName" Property="Foreground" Value="{DynamicResource Accent}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUnsorted}" Value="True">
                                        <Setter TargetName="CellName" Property="Foreground" Value="{DynamicResource FgDim}"/>
                                        <Setter TargetName="CellName" Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Expander>
    </Grid>
</UserControl>
