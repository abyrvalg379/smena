<Window x:Class="SMENA.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:SMENA.ViewModels"
        Title="SMENA" Width="1500" Height="920" MinWidth="1280" MinHeight="760"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}"
        WindowStyle="None" ResizeMode="CanResize"
        Icon="pack://application:,,,/Resources/smena.ico">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="10,7" Margin="8,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHi}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHi}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionHdr" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="18,16,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PanelHi}"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                                <Setter Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="{DynamicResource PanelHi}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHi}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHi}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"
                MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="14,14,12,10" Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentSoft}"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                        <TextBlock Text="⌗" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SMENA" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Fg}"/>
                        <TextBlock Text="Time well spent." FontSize="9" Foreground="{DynamicResource FgDim}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,6,0,0">
                    <Button x:Name="NavDashboard" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Active" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE80F;"/><TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavTimeline" Style="{StaticResource NavBtn}" Click="Nav_Click" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE823;"/><TextBlock Text="Timeline" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSessions" Style="{StaticResource NavBtn}" Click="Nav_Click" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8FD;"/><TextBlock Text="Sessions" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="PROJECTS" Style="{StaticResource SectionHdr}"/>
                    <Button x:Name="NavProjects" Style="{StaticResource NavBtn}" Click="Nav_Click" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8A5;"/><TextBlock Text="Active" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Triggers/>
                    </Button>
                    <Button x:Name="NavProjectsAll" Style="{StaticResource NavBtn}" Click="Nav_Click" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8FD;"/><TextBlock Text="All Projects" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="REPORTS" Style="{StaticResource SectionHdr}"/>
                    <Button x:Name="NavReports" Style="{StaticResource NavBtn}" Click="Nav_Click" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE787;"/><TextBlock Text="Today" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavReportsWeek" Style="{StaticResource NavBtn}" Click="Nav_Click" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8C0;"/><TextBlock Text="This Week" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavReportsMonth" Style="{StaticResource NavBtn}" Click="Nav_Click" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE787;"/><TextBlock Text="This Month" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="INSIGHTS" Style="{StaticResource SectionHdr}"/>
                    <Button x:Name="NavApplications" Style="{StaticResource NavBtn}" Click="Nav_Click" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE71D;"/><TextBlock Text="Applications" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="SETTINGS" Style="{StaticResource SectionHdr}"/>
                    <Button x:Name="NavSettings" Style="{StaticResource NavBtn}" Click="Nav_Click" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE713;"/><TextBlock Text="General / Tracking" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="16,10,12,12">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0" Fill="{DynamicResource Green}"/>
                        <TextBlock Text="Tracking active" FontSize="11" Foreground="{DynamicResource FgDim}"/>
                    </StackPanel>
                    <TextBlock FontSize="10" Foreground="{DynamicResource FgDim}" Margin="0,3,0,0">
                        <Run Text="Auto mode: "/><Run Text="{Binding AutoModeLabel, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= CONTENT ================= -->
        <Grid Grid.Column="1" Margin="20,0,14,14" MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- update banner -->
            <Border Grid.Row="1" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}"
                    BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10"
                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Click="UpdateDismiss_Click" Content="✕" Padding="6,2" FontSize="10"/>
                    <Button DockPanel.Dock="Right" Click="UpdateDownload_Click" Content="DOWNLOAD" Padding="10,3"
                            FontSize="10" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding UpdateLabel}" FontSize="11" Foreground="{DynamicResource Fg}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- page header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="13" Background="Transparent"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="1.5">
                        <TextBlock Text="⬡" FontSize="13" Foreground="{DynamicResource Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Fg}"/>
                        <TextBlock Text="Your time, projects, and progress." FontSize="10" Foreground="{DynamicResource FgDim}" Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Click="PrevDay_Click" Content="‹" Padding="7,2" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource FgDim}"/>
                        <Button Click="Today_Click" Content="{Binding SelectedDateLabel}" Padding="8,2" Background="Transparent"
                                BorderThickness="0" Foreground="{DynamicResource Fg}" FontSize="12"/>
                        <Button Click="NextDay_Click" Content="›" Padding="7,2" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource FgDim}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <ContentControl Grid.Row="2" x:Name="PageHost" MouseLeftButtonDown="Chrome_MouseLeftButtonDown"/>
        </Grid>

        <!-- ================= RIGHT RAIL ================= -->
        <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- window buttons + rail header -->
                <Grid Grid.Row="0" VerticalAlignment="Top">
                    <TextBlock Text="⚙ Quick Actions" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                               Margin="14,10,0,0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource WinBtn}" Click="Fullscreen_Click" Content="&#xE740;" FontFamily="Segoe Fluent Icons" FontSize="9" ToolTip="Fullscreen (F11)"/>
                        <Button Style="{StaticResource WinBtn}" Click="Minimize_Click" Content="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="9"/>
                        <Button Style="{StaticResource WinBtn}" Click="Close_Click" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="9"/>
                    </StackPanel>
                </Grid>

                <!-- Quick Actions -->
                <StackPanel Grid.Row="1" Margin="14,6,14,8">
                    <Button Click="StartStop_Click" FontWeight="SemiBold" Padding="0,9" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="▶  Start Tracking"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsManual}" Value="True">
                                        <Setter Property="Content" Value="■  Stop Tracking"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <ListBox x:Name="QuickTaskList" ItemsSource="{Binding TimerRows}" Margin="0,10,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectedItem="{Binding SelectedQuickTask, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent">
                                    <Grid.ContextMenu>
                                        <ContextMenu Opened="QuickMenu_Opened"/>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding TaskBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Margin="8,0,0,0"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontSize="10"
                                               Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="3" Text="›" FontSize="11" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Click="NewTask_Click" Content="+  New Task" Margin="0,10,0,0" HorizontalAlignment="Stretch"/>
                    <Button Click="ManualEntry_Click" Content="🕐  Manual Entry" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- Global Timer mini -->
                <Border Grid.Row="2" Margin="14,4,14,8" Background="{DynamicResource PanelHi}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="6" Padding="10,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="GLOBAL TIMER" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource FgDim}"/>
                            <TextBlock Text="{Binding HeroTime}" FontFamily="Consolas" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Accent}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Click="Pause_Click" Content="&#xE769;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                VerticalAlignment="Center" Padding="6,4"/>
                    </Grid>
                </Border>

                <!-- Session Details -->
                <Border Grid.Row="3" Margin="14,4,14,8" Background="{DynamicResource PanelHi}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10"
                        Visibility="{Binding SessionDetailsVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="SESSION DETAILS" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Click="CloseDetails_Click" Content="✕" Padding="5,1" FontSize="10"/>
                        </Grid>
                        <TextBlock Text="{Binding SessionTaskLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="STARTED" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource FgDim}"/>
                                <TextBlock Text="{Binding SelectedSession.TimeRange}" FontSize="11" Foreground="{DynamicResource Fg}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="DURATION" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource FgDim}"/>
                                <TextBlock Text="{Binding SelectedSession.Duration}" FontSize="11" Foreground="{DynamicResource Accent}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding SelectedSession.Title}" FontSize="10" Foreground="{DynamicResource FgDim}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Text="NOTE" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource FgDim}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding SessionNote, UpdateSourceTrigger=PropertyChanged}" MinHeight="44"
                                 TextWrapping="Wrap" AcceptsReturn="True" FontSize="11"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Click="SessionSaveNote_Click" Content="SAVE" Padding="7,3" FontSize="10"/>
                            <Button Click="SessionEdit_Click" Content="EDIT" Padding="7,3" FontSize="10" Margin="5,0,0,0"/>
                            <Button Click="SessionSplit_Click" Content="SPLIT" Padding="7,3" FontSize="10" Margin="5,0,0,0"/>
                            <Button Click="SessionAssign_Click" Content="ASSIGN" Padding="7,3" FontSize="10" Margin="5,0,0,0"/>
                            <Button Click="SessionDelete_Click" Content="DEL" Padding="7,3" FontSize="10" Margin="5,0,0,0" Foreground="{DynamicResource RedHi}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Notes -->
                <Border Grid.Row="4" Margin="14,4,14,14" Background="{DynamicResource PanelHi}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="NOTES (selected day)" Style="{StaticResource SectionHdr}" Margin="0,0,0,6"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding NotesItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0" Fill="{Binding Brush}"/>
                                                <TextBlock Text="{Binding TaskName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"/>
                                                <TextBlock Text="{Binding MinutesText}" FontSize="10" Foreground="{DynamicResource FgDim}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding NoteText}" FontSize="10" Foreground="{DynamicResource FgDim}"
                                                       TextWrapping="Wrap" Margin="14,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- assign drawer overlay -->
        <Border Grid.ColumnSpan="3" Width="330" HorizontalAlignment="Right"
                Background="{DynamicResource PanelHi}" BorderBrush="{DynamicResource Accent}"
                BorderThickness="1,0,0,0"
                Visibility="{Binding AssignOpen, Converter={StaticResource BoolToVis}}">
            <Grid Margin="14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding AssignHeader}" Foreground="{DynamicResource FgDim}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>                    <Button Grid.Column="1" Click="AssignClose_Click" Content="✕" Padding="6,1"/>
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding AssignRow.Info}" Foreground="{DynamicResource FgDim}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBox Grid.Row="2" x:Name="AssignSearchBox" Text="{Binding AssignSearch, UpdateSourceTrigger=PropertyChanged}"
                         IsVisibleChanged="AssignSearchBox_IsVisibleChanged" Margin="0,0,0,10"/>
                <ListBox Grid.Row="3" ItemsSource="{Binding AssignTasks}"
                         SelectionChanged="AssignList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Keywords}" FontSize="10" Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- mini task editor popup -->
        <Popup x:Name="MiniPopup" Placement="MousePoint" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource PanelHi}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                    CornerRadius="8" Padding="12,10">
                <StackPanel>
                    <TextBlock x:Name="MiniLabel" Text="" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource FgDim}" Margin="0,0,0,6"/>
                    <TextBox x:Name="MiniBox1" Width="260" FontSize="12" KeyDown="MiniBox_KeyDown"/>
                    <TextBox x:Name="MiniBox2" Width="260" FontSize="12" Margin="0,6,0,0"
                             Visibility="Collapsed" KeyDown="MiniBox_KeyDown"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="MiniOk" Click="MiniOk_Click" Content="OK" FontWeight="SemiBold" Padding="10,4"/>
                        <Button Click="MiniCancel_Click" Content="CANCEL" Padding="10,4" Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- edit drawer overlay -->
        <Border Grid.ColumnSpan="3" Width="330" HorizontalAlignment="Right"
                Background="{DynamicResource PanelHi}" BorderBrush="{DynamicResource Accent}"
                BorderThickness="1,0,0,0"
                Visibility="{Binding EditBlockOpen, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="14,12">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="EDIT BLOCK" Foreground="{DynamicResource FgDim}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Click="EditBlockClose_Click" Content="✕" Padding="6,1"/>
                </Grid>
                <TextBlock Text="{Binding EditingRow.Info}" Foreground="{DynamicResource FgDim}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="DATE" Foreground="{DynamicResource FgDim}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding EditBlockDate, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="3" Text="START" Foreground="{DynamicResource FgDim}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="4" Text="{Binding EditBlockStart, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Text="END" Foreground="{DynamicResource FgDim}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding EditBlockEnd, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Click="EditBlockSave_Click" Content="SAVE" FontWeight="SemiBold"/>
                    <Button Click="EditBlockDelete_Click" Content="DELETE" Margin="8,0,0,0" Foreground="{DynamicResource Red}"/>
                </StackPanel>
                <TextBlock Text="TASK" Style="{StaticResource SectionHdr}" Margin="0,16,0,6"/>
                <ListBox ItemsSource="{Binding EditBlockTasks}" SelectedItem="{Binding EditBlockTask, Mode=TwoWay}"
                         MaxHeight="170" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Keywords}" FontSize="10" Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Click="EditBlockUnsort_Click" Content="SET UNSORTED" FontSize="10" Padding="6,3" Margin="0,8,0,0"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
