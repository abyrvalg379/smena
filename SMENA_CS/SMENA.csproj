<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>annotations</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\smena.ico</ApplicationIcon>
    <AssemblyName>SMENA</AssemblyName>
    <AssemblyTitle>SMENA</AssemblyTitle>
    <AssemblyDescription>Passive time tracker for task accounting</AssemblyDescription>
    <AssemblyVersion>0.24.0.0</AssemblyVersion>
    <FileVersion>0.24.0.0</FileVersion>
    <Company>SMENA</Company>
    <Product>SMENA Time Tracker</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\smena.ico" />
  </ItemGroup>

</Project>
