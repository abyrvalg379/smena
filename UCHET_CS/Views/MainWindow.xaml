<Window x:Class="UCHET.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UCHET.ViewModels"
        Title="SMENA Dashboard" Width="920" Height="620" MinWidth="800" MinHeight="540"
        Icon="pack://application:,,,/Resources/uchet.ico"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E22">

    <Window.Resources>
        <SolidColorBrush x:Key="BrushBg" Color="#1E1E22"/>
        <SolidColorBrush x:Key="BrushPanel" Color="#26262B"/>
        <SolidColorBrush x:Key="BrushPanel2" Color="#2C2C33"/>
        <SolidColorBrush x:Key="BrushBorder" Color="#3A3A42"/>
        <SolidColorBrush x:Key="BrushFg" Color="#E8E8EC"/>
        <SolidColorBrush x:Key="BrushDim" Color="#9A9AA5"/>
        <SolidColorBrush x:Key="BrushAccent" Color="#5AC8FA"/>
        <SolidColorBrush x:Key="BrushGreen" Color="#4CD964"/>
        <SolidColorBrush x:Key="BrushOrange" Color="#FF9F0A"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BrushPanel2}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushFg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrushFg}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushFg}"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="0,0,0,1" Padding="10,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPanel2}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPanel2}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushFg}"/>
            <Setter Property="Background" Value="{StaticResource BrushPanel2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource BrushDim}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,2"
                                BorderBrush="Transparent" Padding="16,7" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" TextElement.FontSize="13"
                                              TextElement.FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushFg}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrushFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushFg}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1" Text="{Binding TodayTotal}" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Grid.Column="2" x:Name="ManualButton" Click="ManualButton_Click"
                    Content="{Binding ManualButtonText}" FontWeight="SemiBold"/>
        </Grid>

        <!-- tabs -->
        <TabControl Grid.Row="1" Margin="0,14,0,0">

            <!-- TODAY -->
            <TabItem Header="TODAY">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- day timeline strip -->
                    <Border Grid.Row="0" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="16"/>
                            </Grid.RowDefinitions>
                            <Canvas x:Name="TimelineCanvas" Grid.Row="0"/>
                            <Canvas x:Name="TimelineLabels" Grid.Row="1"/>
                        </Grid>
                    </Border>

                    <!-- column headers -->
                    <Grid Grid.Row="1" Margin="12,0,22,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="TASK" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Grid.Column="2" Text="PROJECT" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Grid.Column="3" Text="SESSION" Style="{StaticResource SectionHeader}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="TODAY" Style="{StaticResource SectionHeader}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="TOTAL" Style="{StaticResource SectionHeader}" TextAlignment="Right"/>
                    </Grid>

                    <!-- stopwatch board -->
                    <ListBox Grid.Row="2" x:Name="TimerList" ItemsSource="{Binding TimerRows}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent" PreviewMouseLeftButtonDown="BoardRow_MouseDown">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Start / stop stopwatch" Click="MenuRowToggle_Click"/>
                                            <MenuItem Header="Rename (F2)" Click="MenuRowRename_Click"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="Dot" Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{StaticResource BrushDim}" Opacity="0.35"/>
                                    <TextBlock x:Name="TaskName" Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                               Foreground="{StaticResource BrushFg}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBox x:Name="NameEdit" Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="Collapsed" FontSize="13" KeyDown="NameEdit_KeyDown" IsVisibleChanged="NameEdit_IsVisibleChanged"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Project}" FontSize="12"
                                               Foreground="{StaticResource BrushDim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Session" Grid.Column="3" Text="{Binding SessionText}" FontSize="13"
                                               Foreground="{StaticResource BrushDim}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding TodayText}" FontSize="12" Foreground="{StaticResource BrushFg}"
                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding TotalText}" FontSize="12" Foreground="{StaticResource BrushAccent}"
                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                    <Button x:Name="RowManual" Grid.Column="6" Click="MenuRowToggle_Click" Content="▶"
                                            FontSize="11" Padding="2,2" Width="32" Margin="8,0,0,0"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter TargetName="TaskName" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="NameEdit" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource BrushGreen}"/>
                                        <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                                        <Setter TargetName="Session" Property="Foreground" Value="{StaticResource BrushGreen}"/>
                                        <Setter TargetName="Session" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ManualMark}" Value="True">
                                        <Setter TargetName="RowManual" Property="Content" Value="■"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TaskId}" Value="{x:Null}">
                                        <Setter TargetName="RowManual" Property="IsEnabled" Value="False"/>
                                        <Setter TargetName="RowManual" Property="Opacity" Value="0.3"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- raw activity log, collapsed by default -->
                    <Expander Grid.Row="3" x:Name="ActivityExpander" IsExpanded="False" Margin="0,10,0,0"
                              Foreground="{StaticResource BrushDim}">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ACTIVITY LOG" FontWeight="SemiBold" FontSize="11"/>
                                <Button Grid.Column="1" Click="Collapse_Click" Content="COLLAPSE SELECTED" FontSize="10"
                                        Padding="6,2" Margin="0,0,6,0" ToolTip="Merge selected rows (Shift-click range) into one block"/>
                                <Button Grid.Column="2" Click="AddBlock_Click" Content="+ ADD BLOCK" FontSize="10"
                                        Padding="6,2"/>
                            </Grid>
                        </Expander.Header>
                        <ListBox x:Name="ActivityLogList" Height="170" ItemsSource="{Binding TodayRows}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionMode="Extended"
                                 SelectionChanged="ActivityLogList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Assign to task…" Click="MenuBlockAssign_Click"/>
                                                <MenuItem Header="Collapse selected" Click="MenuBlockCollapse_Click"/>
                                                <MenuItem Header="Edit block…" Click="MenuBlockEdit_Click"/>
                                                <MenuItem Header="Delete" Click="MenuBlockDelete_Click"/>
                                                <MenuItem Header="Copy title" Click="MenuBlockCopy_Click"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TimeRange}" Foreground="{StaticResource BrushDim}" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Duration}" Foreground="{StaticResource BrushAccent}" FontSize="11"/>
                                        <TextBlock Grid.Column="2" Text="{Binding App}" Foreground="{StaticResource BrushDim}" FontSize="11"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Task}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Title}" Foreground="{StaticResource BrushDim}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>

                    <!-- assign drawer (overlay, right side) -->
                    <Border Grid.Row="0" Grid.RowSpan="4" Width="330" HorizontalAlignment="Right"
                            Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushAccent}"
                            BorderThickness="1,0,0,0"
                            Visibility="{Binding AssignOpen, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="14,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ASSIGN TO TASK" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" Margin="0"/>
                                <Button Grid.Column="1" Click="AssignClose_Click" Content="✕" Padding="7,2"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding AssignRow.Info}" Foreground="{StaticResource BrushDim}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="2" x:Name="AssignSearchBox" Text="{Binding AssignSearch, UpdateSourceTrigger=PropertyChanged}"
                                     IsVisibleChanged="AssignSearchBox_IsVisibleChanged" Margin="0,0,0,10"/>
                            <ListBox Grid.Row="3" x:Name="AssignList" ItemsSource="{Binding AssignTasks}"
                                     SelectionChanged="AssignList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource BrushFg}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Keywords}" FontSize="11" Foreground="{StaticResource BrushDim}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- block edit drawer (overlay, right side) -->
                    <Border Grid.Row="0" Grid.RowSpan="4" Width="330" HorizontalAlignment="Right"
                            Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushAccent}"
                            BorderThickness="1,0,0,0"
                            Visibility="{Binding EditBlockOpen, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="14,12">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="EDIT BLOCK" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" Margin="0"/>
                                <Button Grid.Column="1" Click="EditBlockClose_Click" Content="✕" Padding="7,2"/>
                            </Grid>
                            <TextBlock Text="{Binding EditingRow.Info}" Foreground="{StaticResource BrushDim}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="DATE" Foreground="{StaticResource BrushDim}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditBlockDate, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="START" Foreground="{StaticResource BrushDim}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding EditBlockStart, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="2" Text="END" Foreground="{StaticResource BrushDim}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding EditBlockEnd, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Click="EditBlockSave_Click" Content="SAVE" FontWeight="SemiBold"/>
                                <Button Click="EditBlockDelete_Click" Content="DELETE" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="TASK" Style="{StaticResource SectionHeader}" Margin="0,16,0,6"/>
                            <ListBox ItemsSource="{Binding EditBlockTasks}" SelectedItem="{Binding EditBlockTask, Mode=TwoWay}"
                                     MaxHeight="170" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource BrushFg}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Keywords}" FontSize="10" Foreground="{StaticResource BrushDim}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Click="EditBlockUnsort_Click" Content="SET UNSORTED" FontSize="10" Padding="6,3" Margin="0,8,0,0"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- WEEK -->
            <TabItem Header="WEEK">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,0,20,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="TASK" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Grid.Column="1" Text="{Binding WeekDayHeaders[0]}" Style="{StaticResource SectionHeader}" FontSize="10" TextAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="{Binding WeekDayHeaders[1]}" Style="{StaticResource SectionHeader}" FontSize="10" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="{Binding WeekDayHeaders[2]}" Style="{StaticResource SectionHeader}" FontSize="10" TextAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="{Binding WeekDayHeaders[3]}" Style="{StaticResource SectionHeader}" FontSize="10" TextAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="{Binding WeekDayHeaders[4]}" Style="{StaticResource SectionHeader}" FontSize="10" TextAlignment="Right"/>
                        <TextBlock Grid.Column="6" Text="{Binding WeekDayHeaders[5]}" Style="{StaticResource SectionHeader}" FontSize="10" TextAlignment="Right"/>
                        <TextBlock Grid.Column="7" Text="{Binding WeekDayHeaders[6]}" Style="{StaticResource SectionHeader}" FontSize="10" TextAlignment="Right"/>
                        <TextBlock Grid.Column="8" Text="TOTAL" Style="{StaticResource SectionHeader}" TextAlignment="Right"/>
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding WeekGrid}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CellName" Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                               Foreground="{StaticResource BrushFg}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Cells[0]}" FontSize="11" Foreground="{StaticResource BrushFg}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Cells[1]}" FontSize="11" Foreground="{StaticResource BrushFg}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Cells[2]}" FontSize="11" Foreground="{StaticResource BrushFg}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Cells[3]}" FontSize="11" Foreground="{StaticResource BrushFg}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Cells[4]}" FontSize="11" Foreground="{StaticResource BrushFg}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="6" Text="{Binding Cells[5]}" FontSize="11" Foreground="{StaticResource BrushFg}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="7" Text="{Binding Cells[6]}" FontSize="11" Foreground="{StaticResource BrushFg}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="8" Text="{Binding Total}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushAccent}" TextAlignment="Right"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsGroupRow}" Value="True">
                                        <Setter TargetName="CellName" Property="FontWeight" Value="SemiBold"/>
                                        <Setter TargetName="CellName" Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsGroupRow}" Value="False">
                                        <Setter TargetName="CellName" Property="Margin" Value="18,0,0,0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                                        <Setter TargetName="CellName" Property="FontWeight" Value="Bold"/>
                                        <Setter TargetName="CellName" Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUnsorted}" Value="True">
                                        <Setter TargetName="CellName" Property="Foreground" Value="{StaticResource BrushDim}"/>
                                        <Setter TargetName="CellName" Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- TASKS -->
            <TabItem Header="TASKS">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- projects -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="PROJECTS" Style="{StaticResource SectionHeader}"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="13"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="NewProjectBox" Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="NewProjectBox_KeyDown"/>
                            <Button Grid.Column="2" x:Name="AddProjectButton" Click="AddProject_Click" Content="ADD"/>
                            <Button Grid.Column="4" x:Name="DelProjectButton" Click="DelProject_Click" Content="DEL"/>
                        </Grid>
                    </Grid>

                    <!-- tasks -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="TASKS" Style="{StaticResource SectionHeader}"/>
                        <ListBox Grid.Row="1" x:Name="TasksList" ItemsSource="{Binding SelectedProjectTasks}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}">
                            <ListBox.ContextMenu>
                                <ContextMenu Opened="TasksMenu_Opened"/>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Keywords}" Foreground="{StaticResource BrushDim}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="EditTaskName" Text="{Binding SelectedTask.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="1" x:Name="EditTaskKeywords" Text="{Binding SelectedTask.Keywords, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="3" x:Name="SaveTaskButton" Click="SaveTasks_Click" Content="SAVE"/>
                                <Button Grid.Column="5" x:Name="DelTaskButton" Click="DelTask_Click" Content="DEL"/>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="NewTaskBox" Text="{Binding NewTaskName, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="NewTaskBox_KeyDown"/>
                                <TextBox Grid.Column="2" x:Name="NewKeywordsBox" Text="{Binding NewTaskKeywords, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="4" x:Name="AddTaskButton" Click="AddTask_Click" Content="ADD"/>
                            </Grid>
                            <TextBlock Grid.Row="4" Foreground="{StaticResource BrushDim}" FontSize="11"
                                       Text="Keywords: comma-separated, matched against window title or process name. Unmatched time goes to Unsorted."/>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- SETTINGS -->
            <TabItem Header="SETTINGS">
                <StackPanel Margin="0,14,0,0" MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Text="TRACKING" Style="{StaticResource SectionHeader}"/>
                    <Border Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1" CornerRadius="4" Padding="14,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Idle timeout (minutes):" Foreground="{StaticResource BrushFg}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="IdleBox" Text="{Binding IdleTimeoutMinutes, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <CheckBox x:Name="AutoStartCheck" Content="Start with Windows" Foreground="{StaticResource BrushFg}" FontSize="12"
                                      IsChecked="{Binding AutoStart, Mode=TwoWay}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="EXPORT CSV" Style="{StaticResource SectionHeader}" Margin="0,16,0,6"/>
                    <Border Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1" CornerRadius="4" Padding="14,12">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ExportTodayButton" Click="ExportToday_Click" Content="TODAY"/>
                            <Button x:Name="ExportWeekButton" Click="ExportWeek_Click" Content="WEEK" Margin="8,0,0,0"/>
                            <Button x:Name="ExportMonthButton" Click="ExportMonth_Click" Content="MONTH" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="DATA" Style="{StaticResource SectionHeader}" Margin="0,16,0,6"/>
                    <Border Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1" CornerRadius="4" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding DataFolder}" Foreground="{StaticResource BrushDim}" FontSize="11"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" x:Name="OpenFolderButton" Click="OpenFolder_Click" Content="OPEN"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- footer -->
        <TextBlock Grid.Row="2" Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource BrushDim}"
                   Text="Polls the active window every 5 s. Idle longer than the timeout pauses tracking (block ends at your last input)."/>
    </Grid>
</Window>
