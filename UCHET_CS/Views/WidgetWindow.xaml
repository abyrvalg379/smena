<Window x:Class="UCHET.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UCHET.ViewModels"
        Title="SMENA" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" ResizeMode="NoResize"
        Icon="pack://application:,,,/Resources/uchet.ico"
        Topmost="{Binding WidgetTopmost, Mode=TwoWay}"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PanelHi}"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="6,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHi}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Hdr" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PulseDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource FgDim}"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource Green}"/>
                    <Setter Property="Opacity" Value="1"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PulseSb">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.25" Duration="0:0:0.85"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="PulseSb"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
    <Border x:Name="Root" CornerRadius="14" Background="{DynamicResource Bg}"
            BorderThickness="1" Padding="0">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Orange}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>

            <!-- header: logo chip + window buttons (dashboard sidebar style) -->
            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="12,10,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource AccentSoft}"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                        <TextBlock Text="⌗" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SMENA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Fg}"/>
                        <TextBlock Text="Time well spent." FontSize="8" Foreground="{DynamicResource FgDim}" Margin="0,-1,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconBtn}" Click="Pause_Click" Margin="0,0,2,0"
                        ToolTip="Pause / resume tracking">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE769;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Text" Value="&#xE768;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Orange}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource IconBtn}" Click="Pin_Click" Margin="0,0,2,0"
                        ToolTip="Always on top">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE77A;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WidgetTopmost}" Value="True">
                                        <Setter Property="Text" Value="&#xE718;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource IconBtn}" Click="Dashboard_Click" Margin="0,0,2,0"
                        ToolTip="Dashboard (tasks, week, export)">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="11" Text="&#xE700;"/>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource IconBtn}" Click="CloseBtn_Click" ToolTip="Hide to tray">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="11" Text="&#xE8BB;"/>
                </Button>
            </Grid>

            <!-- WORKING card: same gradient hero as the dashboard -->
            <Border Margin="12,10,12,0" CornerRadius="10" Padding="12,10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#101720" Offset="0"/>
                        <GradientStop Color="#0F2318" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#1D3324" CornerRadius="4" Padding="8,3">
                            <TextBlock FontSize="9" FontWeight="Bold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="IDLE"/>
                                        <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Text" Value="WORKING"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Green}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{Binding StatusLine}" FontSize="9" Foreground="{DynamicResource FgDim}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <TextBlock Text="{Binding HeroTime}" FontFamily="Consolas" FontSize="30" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg}" Margin="0,6,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,1,7,0"
                                 Style="{StaticResource PulseDot}"/>
                        <TextBlock Text="{Binding WorkingTaskName}" FontSize="13" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WorkingTaskName}" Value="">
                                            <Setter Property="Text" Value="nothing tracked"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Background="{DynamicResource PanelHi}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                CornerRadius="4" Padding="7,3" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                           Foreground="{DynamicResource FgDim}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentApp}" FontSize="10" Foreground="{DynamicResource Fg}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelHi}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                CornerRadius="4" Padding="7,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                           Foreground="{DynamicResource FgDim}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentFile}" FontSize="10" Foreground="{DynamicResource Fg}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding TodayTotal}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- tasks -->
            <TextBlock Text="TASKS" Style="{StaticResource Hdr}" Margin="16,10,0,4"/>
            <ItemsControl ItemsSource="{Binding TimerRows}" Margin="10,0,10,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2" Background="Transparent">
                            <Grid.ContextMenu>
                                <ContextMenu Opened="RowMenu_Opened"/>
                            </Grid.ContextMenu>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="66"/>
                                <ColumnDefinition Width="52"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource IconBtn}" Click="RowToggle_Click"
                                    Width="22" Height="20" HorizontalAlignment="Left" Padding="4,2"
                                    ToolTip="Manual stopwatch">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="10" Text="{Binding Glyph}"/>
                            </Button>
                            <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding TaskBrush}"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="TaskName" Grid.Column="2" Text="{Binding Name}" FontSize="12"
                                       Margin="6,0,0,0"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Green}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="NameEdit" Grid.Column="2" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="Collapsed" FontSize="12" Padding="2,0"
                                     KeyDown="WidgetNameEdit_KeyDown" IsVisibleChanged="WidgetNameEdit_IsVisibleChanged"/>
                            <TextBlock Grid.Column="3" Text="{Binding SessionText}" FontFamily="Consolas" FontSize="12"
                                       TextAlignment="Right" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Green}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="4" Text="{Binding TotalText}" FontSize="10"
                                       Foreground="{DynamicResource FgDim}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter TargetName="TaskName" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="NameEdit" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- quick add -->
            <Grid Margin="12,8,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="QuickBox" FontSize="12" Padding="8,5" VerticalContentAlignment="Center"
                         KeyDown="QuickBox_KeyDown"/>
                <Button Grid.Column="1" Style="{StaticResource IconBtn}" Click="QuickAdd_Click" Margin="6,0,0,0"
                        ToolTip="Add task">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="12" Text="&#xE710;"/>
                </Button>
            </Grid>

            <!-- today strip -->
            <Border Margin="12,10,12,12" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="10" Padding="10,2">
                <StackPanel>
                    <Canvas x:Name="MiniTimeline" Height="20"/>
                    <Canvas x:Name="MiniTimelineLabels" Height="11"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>

    <!-- keywords quick editor -->
    <Popup x:Name="KwPopup" Placement="MousePoint" StaysOpen="False" AllowsTransparency="True">
        <Border Background="{DynamicResource PanelHi}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="8" Padding="10">
            <StackPanel>
                <TextBlock Text="KEYWORDS (comma-separated)" FontSize="9" FontWeight="SemiBold"
                           Foreground="{DynamicResource FgDim}" Margin="0,0,0,6"/>
                <TextBox x:Name="KwBox" Width="250" FontSize="12" KeyDown="KwBox_KeyDown"/>
            </StackPanel>
        </Border>
    </Popup>

    <!-- start-with-offset quick editor -->
    <Popup x:Name="OffsetPopup" Placement="MousePoint" StaysOpen="False" AllowsTransparency="True">
        <Border Background="{DynamicResource PanelHi}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="8" Padding="10">
            <StackPanel>
                <TextBlock Text="ALREADY DONE (HH:MM) — TIMER WILL CONTINUE FROM IT" FontSize="9" FontWeight="SemiBold"
                           Foreground="{DynamicResource FgDim}" Margin="0,0,0,6"/>
                <TextBox x:Name="OffsetBox" Width="140" FontSize="13" FontFamily="Consolas" KeyDown="OffsetBox_KeyDown"/>
            </StackPanel>
        </Border>
    </Popup>
    </Grid>
</Window>
