<UserControl x:Class="UCHET.Views.TimelinePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <Style x:Key="Hdr" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="TIMELINE" Style="{StaticResource Hdr}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="16"/>
                    </Grid.RowDefinitions>
                    <Canvas x:Name="TimelineCanvas" Grid.Row="0"/>
                    <Canvas x:Name="TimelineLabels" Grid.Row="1"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="ACTIVITY LOG — click a row to assign · Shift-click range + COLLAPSE to merge" Style="{StaticResource Hdr}" Margin="0,0,0,6"/>
                <ListBox Grid.Row="1" x:Name="LogList" ItemsSource="{Binding TodayRows}" SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="LogList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Assign to task…" Click="MenuBlockAssign_Click"/>
                                        <MenuItem Header="Collapse selected" Click="MenuBlockCollapse_Click"/>
                                        <MenuItem Header="Edit block…" Click="MenuBlockEdit_Click"/>
                                        <MenuItem Header="Delete" Click="MenuBlockDelete_Click"/>
                                        <MenuItem Header="Copy title" Click="MenuBlockCopy_Click"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeRange}" Foreground="{DynamicResource FgDim}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Duration}" Foreground="{DynamicResource Accent}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding App}" Foreground="{DynamicResource FgDim}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Task}" FontSize="11" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding Title}" Foreground="{DynamicResource FgDim}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
