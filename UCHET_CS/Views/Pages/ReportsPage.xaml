<UserControl x:Class="UCHET.Views.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Hdr" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent" Padding="8,5"><ContentPresenter/></Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="THIS WEEK — tasks × days" Style="{StaticResource Hdr}" Margin="4,0,0,8"/>
        <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="8" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="TASK" Style="{StaticResource Hdr}"/>
                    <TextBlock Grid.Column="1" Text="{Binding WeekDayHeaders[0]}" Style="{StaticResource Hdr}" FontSize="10" TextAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="{Binding WeekDayHeaders[1]}" Style="{StaticResource Hdr}" FontSize="10" TextAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="{Binding WeekDayHeaders[2]}" Style="{StaticResource Hdr}" FontSize="10" TextAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="{Binding WeekDayHeaders[3]}" Style="{StaticResource Hdr}" FontSize="10" TextAlignment="Right"/>
                    <TextBlock Grid.Column="5" Text="{Binding WeekDayHeaders[4]}" Style="{StaticResource Hdr}" FontSize="10" TextAlignment="Right"/>
                    <TextBlock Grid.Column="6" Text="{Binding WeekDayHeaders[5]}" Style="{StaticResource Hdr}" FontSize="10" TextAlignment="Right"/>
                    <TextBlock Grid.Column="7" Text="{Binding WeekDayHeaders[6]}" Style="{StaticResource Hdr}" FontSize="10" TextAlignment="Right"/>
                    <TextBlock Grid.Column="8" Text="TOTAL" Style="{StaticResource Hdr}" TextAlignment="Right"/>
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding WeekGrid}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CellName" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Fg}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Cells[0]}" FontSize="11" Foreground="{DynamicResource Fg}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="{Binding Cells[1]}" FontSize="11" Foreground="{DynamicResource Fg}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="{Binding Cells[2]}" FontSize="11" Foreground="{DynamicResource Fg}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="{Binding Cells[3]}" FontSize="11" Foreground="{DynamicResource Fg}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="{Binding Cells[4]}" FontSize="11" Foreground="{DynamicResource Fg}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="6" Text="{Binding Cells[5]}" FontSize="11" Foreground="{DynamicResource Fg}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="7" Text="{Binding Cells[6]}" FontSize="11" Foreground="{DynamicResource Fg}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="8" Text="{Binding Total}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" TextAlignment="Right"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsGroupRow}" Value="True">
                                    <Setter TargetName="CellName" Property="FontWeight" Value="SemiBold"/>
                                    <Setter TargetName="CellName" Property="Foreground" Value="{DynamicResource Accent}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsGroupRow}" Value="False">
                                    <Setter TargetName="CellName" Property="Margin" Value="18,0,0,0"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                                    <Setter TargetName="CellName" Property="FontWeight" Value="Bold"/>
                                    <Setter TargetName="CellName" Property="Foreground" Value="{DynamicResource Accent}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsUnsorted}" Value="True">
                                    <Setter TargetName="CellName" Property="Foreground" Value="{DynamicResource FgDim}"/>
                                    <Setter TargetName="CellName" Property="FontStyle" Value="Italic"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
